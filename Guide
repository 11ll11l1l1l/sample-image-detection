Given your complex X-ray image conditions, where bumps vary in hue, alignment, and contrast, and cold joints can be identified by overlap and color differences, we need a more robust image processing approach. Here’s how to refine the detection:


---

1. Strategy for Detection

1. Normalize Contrast: Use CLAHE (Contrast Limited Adaptive Histogram Equalization) to enhance visibility.


2. Multi-Threshold Segmentation: Differentiate white, black, and light bumps.


3. Edge Detection & Shape Filtering: Identify bumps despite varying hues.


4. Overlapping (Cold Joint) Detection: Identify overlaps based on pixel intensity and contour merging.




---

2. Improved Image Preprocessing

Since bumps have varying brightness, Adaptive Histogram Equalization (CLAHE) will enhance features.

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Load image
image = cv2.imread("xray_image.png", cv2.IMREAD_GRAYSCALE)

# Apply CLAHE for contrast normalization
clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
image_clahe = clahe.apply(image)

# Apply Gaussian Blur to reduce noise
blurred = cv2.GaussianBlur(image_clahe, (5,5), 0)

# Display results
plt.figure(figsize=(10,5))
plt.subplot(1,2,1), plt.imshow(image, cmap='gray'), plt.title("Original X-ray")
plt.subplot(1,2,2), plt.imshow(image_clahe, cmap='gray'), plt.title("CLAHE Enhanced")
plt.show()


---

3. Multi-Threshold Segmentation for Mixed Colors

Since bumps have varying intensities, multiple thresholds help segment them.

# Apply multiple thresholds to extract bumps of different brightness levels
_, thresh_dark = cv2.threshold(image_clahe, 50, 255, cv2.THRESH_BINARY)  # Dark bumps
_, thresh_light = cv2.threshold(image_clahe, 180, 255, cv2.THRESH_BINARY_INV)  # Light bumps

# Combine thresholds
thresh_combined = cv2.bitwise_or(thresh_dark, thresh_light)

# Display thresholded images
plt.figure(figsize=(15,5))
plt.subplot(1,3,1), plt.imshow(thresh_dark, cmap="gray"), plt.title("Dark Bumps")
plt.subplot(1,3,2), plt.imshow(thresh_light, cmap="gray"), plt.title("Light Bumps")
plt.subplot(1,3,3), plt.imshow(thresh_combined, cmap="gray"), plt.title("Combined")
plt.show()


---

4. Contour Detection & Circularity Filtering

Since bumps may not always be aligned, we detect contours and filter by shape and area.

# Find contours
contours, _ = cv2.findContours(thresh_combined, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

# Filter bumps based on circularity and area
bump_contours = []
for cnt in contours:
    area = cv2.contourArea(cnt)
    perimeter = cv2.arcLength(cnt, True)
    if perimeter == 0:
        continue
    circularity = 4 * np.pi * (area / (perimeter ** 2))
    
    if 0.6 < circularity < 1.2 and 50 < area < 2000:  # Adjust based on bump size
        bump_contours.append(cnt)

# Draw detected bumps
image_bumps = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)
cv2.drawContours(image_bumps, bump_contours, -1, (0, 255, 0), 2)

plt.imshow(image_bumps)
plt.title("Detected Bumps")
plt.show()


---

5. Cold Joint & Overlapping Bump Detection

Cold joints appear as overlapping or fused contours. We use contour merging detection.

def detect_cold_joints(contours):
    cold_joints = []
    for i, cnt1 in enumerate(contours):
        x1, y1, w1, h1 = cv2.boundingRect(cnt1)
        for j, cnt2 in enumerate(contours):
            if i >= j:
                continue
            x2, y2, w2, h2 = cv2.boundingRect(cnt2)
            if abs(x1 - x2) < 10 and abs(y1 - y2) < 10:  # Threshold for overlap
                cold_joints.append((cnt1, cnt2))
    return cold_joints

cold_joint_pairs = detect_cold_joints(bump_contours)

# Draw cold joint defects
for cnt1, cnt2 in cold_joint_pairs:
    cv2.drawContours(image_bumps, [cnt1], -1, (0, 0, 255), 2)  # Mark in red
    cv2.drawContours(image_bumps, [cnt2], -1, (0, 0, 255), 2)

plt.imshow(image_bumps)
plt.title("Cold Joints Marked")
plt.show()


