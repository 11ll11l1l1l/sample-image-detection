To create an image analysis program using Python for detecting bump size, position, and anomalies using 2D X-ray images, you can follow these steps:


---

1. Install Required Libraries

pip install opencv-python numpy scikit-image matplotlib


---

2. Load and Preprocess the Image

Convert the image to grayscale.

Apply adaptive thresholding or edge detection to isolate bumps.


import cv2
import numpy as np
import matplotlib.pyplot as plt

# Load the X-ray image
image = cv2.imread("xray_image.png", cv2.IMREAD_GRAYSCALE)

# Apply Gaussian blur to reduce noise
blurred = cv2.GaussianBlur(image, (5, 5), 0)

# Use adaptive thresholding for better contrast
thresh = cv2.adaptiveThreshold(blurred, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, 
                               cv2.THRESH_BINARY_INV, 11, 2)

# Display the thresholded image
plt.imshow(thresh, cmap="gray")
plt.title("Thresholded Image")
plt.show()


---

3. Detect Bumps Using Contours

Use OpenCV’s findContours to detect circular structures.

Filter based on size to remove noise.


# Find contours in the binary image
contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

# Filter bumps based on area and circularity
bump_contours = []
for cnt in contours:
    area = cv2.contourArea(cnt)
    if 100 < area < 2000:  # Adjust these values based on expected bump size
        perimeter = cv2.arcLength(cnt, True)
        circularity = 4 * np.pi * (area / (perimeter ** 2))
        if 0.7 < circularity < 1.2:  # Close to 1 means it's a circle
            bump_contours.append(cnt)

# Draw detected bumps
image_bumps = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)
cv2.drawContours(image_bumps, bump_contours, -1, (0, 255, 0), 2)

plt.imshow(image_bumps)
plt.title("Detected Bumps")
plt.show()


---

4. Measure Bump Size & Position

Extract centroids and diameters.


bump_data = []

for cnt in bump_contours:
    M = cv2.moments(cnt)
    if M["m00"] != 0:
        cx = int(M["m10"] / M["m00"])  # X-coordinate of bump center
        cy = int(M["m01"] / M["m00"])  # Y-coordinate of bump center
        area = cv2.contourArea(cnt)
        diameter = np.sqrt(4 * area / np.pi)  # Approximate as a circle

        bump_data.append((cx, cy, diameter))

# Display bump positions and sizes
for cx, cy, d in bump_data:
    cv2.circle(image_bumps, (cx, cy), int(d / 2), (255, 0, 0), 2)
    cv2.putText(image_bumps, f"{d:.1f}", (cx, cy), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)

plt.imshow(image_bumps)
plt.title("Bump Sizes & Positions")
plt.show()


