    # -----------------------------------------
    # 4. Image Display Panel
    # -----------------------------------------
    def create_image_panel(self):
        self.image_panel = tk.Label(self.master)
        self.image_panel.pack(side=tk.RIGHT, expand=True, fill=tk.BOTH)
        
    # -----------------------------------------
    # 5. Load Image
    # -----------------------------------------
    def open_image(self):
        file_path = filedialog.askopenfilename(filetypes=[("Image Files", "*.png *.jpg *.jpeg *.bmp")])
        if not file_path:
            return
        
        self.original_image = cv2.imread(file_path, cv2.IMREAD_GRAYSCALE)
        if self.original_image is None:
            messagebox.showerror("Error", "Could not open image.")
            return
        
        # Reset results
        self.bumps_contours = []
        self.processed_image = None
        self.last_anomaly_scores = []
        
        self.show_image(self.original_image)
        
    # -----------------------------------------
    # 6. Apply Filters & Preprocessing
    # -----------------------------------------
    def process_image(self):
        if self.original_image is None:
            messagebox.showwarning("Warning", "No image loaded.")
            return
        
        img = self.original_image.copy()
        
        # Gaussian Blur
        blur_k = self.blur_kernel_var.get()
        if blur_k > 0:
            img = cv2.GaussianBlur(img, (blur_k, blur_k), 0)
        
        # CLAHE
        if self.use_clahe_var.get():
            clahe = cv2.createCLAHE(clipLimit=RECIPE["clahe_clip"], 
                                    tileGridSize=(RECIPE["clahe_grid"], RECIPE["clahe_grid"]))
            img = clahe.apply(img)
        
        self.processed_image = img
        self.show_image(img)
        messagebox.showinfo("Info", "Image processing completed.")
        
    # -----------------------------------------
    # 7. Detect Bumps
    # -----------------------------------------
    def detect_bumps(self):
        if self.processed_image is None:
            messagebox.showwarning("Warning", "Please process the image first.")
            return
        
        img = self.processed_image.copy()
        
        # Multi-threshold
        _, dark_bin = cv2.threshold(img, self.thresh_dark_var.get(), 255, cv2.THRESH_BINARY)
        _, light_bin = cv2.threshold(img, self.thresh_light_var.get(), 255, cv2.THRESH_BINARY_INV)
        
        combined = cv2.bitwise_or(dark_bin, light_bin)
        
        # Find contours
        contours, _ = cv2.findContours(combined, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        # Filter by area & circularity
        filtered_contours = []
        for cnt in contours:
            area = cv2.contourArea(cnt)
            perimeter = cv2.arcLength(cnt, True)
            if perimeter == 0:
                continue
            circularity = 4 * np.pi * (area / (perimeter**2))
            if (RECIPE["area_min"] < area < RECIPE["area_max"] and
                RECIPE["circularity_low"] < circularity < RECIPE["circularity_high"]):
                filtered_contours.append(cnt)
        
        self.bumps_contours = filtered_contours
        
        # Optional: run anomaly detection if the user has trained an AE and enabled it
        ae_anomaly_enabled = self.use_ae_anomaly_var.get()
        self.last_anomaly_scores = []
        
        # Convert to color for visualization
        display_img = cv2.cvtColor(self.processed_image, cv2.COLOR_GRAY2BGR)
        
        for cnt_idx, cnt in enumerate(filtered_contours):
            color = (0, 255, 0)  # green by default
            # Draw contour
            cv2.drawContours(display_img, [cnt], -1, color, 2)
        
        if ae_anomaly_enabled and self.ae_trained and self.autoencoder:
            # Compute anomaly scores for each bump
            anomaly_threshold = self.anomaly_thresh_var.get()
            patch_size = RECIPE["autoencoder_patch_size"]
            
            for cnt_idx, cnt in enumerate(filtered_contours):
                x, y, w, h = cv2.boundingRect(cnt)
                crop = self.processed_image[y:y+h, x:x+w]
                crop_resized = cv2.resize(crop, (patch_size, patch_size))
                crop_resized = crop_resized.astype(np.float32) / 255.0
                crop_resized = np.expand_dims(crop_resized, axis=[0, -1])  # shape (1, h, w, 1)
                
                # Predict
                recon = self.autoencoder.predict(crop_resized)
                
                # Calculate error (e.g., MAE)
                error = np.mean(np.abs(crop_resized - recon))
                self.last_anomaly_scores.append(error)
                
                # If above threshold => color red
                if error > anomaly_threshold:
                    cv2.drawContours(display_img, [cnt], -1, (0, 0, 255), 2)  # red
        else:
            self.last_anomaly_scores = [-1]*len(filtered_contours)
        
        self.show_image(display_img)
        
        # Missing & Misalignment
        missing, misaligned = self.check_grid_defects(filtered_contours)
        
        msg = (f"Total Bumps Detected: {len(filtered_contours)}\n"
               f"Missing Bumps: {len(missing)}\n"
               f"Misaligned Bumps: {len(misaligned)}\n")
        if ae_anomaly_enabled and self.ae_trained:
            # Count anomalies
            anomaly_count = sum(1 for e in self.last_anomaly_scores if e > self.anomaly_thresh_var.get())
            msg += f"Anomalies Detected (AE): {anomaly_count}\n"
        
        messagebox.showinfo("Detection Results", msg)

    def check_grid_defects(self, contours):
        gx = np.arange(RECIPE["grid_x_start"], RECIPE["grid_x_end"], RECIPE["grid_x_step"])
        gy = np.arange(RECIPE["grid_y_start"], RECIPE["grid_y_end"], RECIPE["grid_y_step"])
        expected_positions = [(x, y) for x in gx for y in gy]
        
        detected_positions = []
        for cnt in contours:
            M = cv2.moments(cnt)
            if M["m00"] != 0:
                cx = int(M["m10"] / M["m00"])
                cy = int(M["m01"] / M["m00"])
                detected_positions.append((cx, cy))
        
        missing_bumps = []
        misaligned_bumps = []
        align_thresh = self.align_thresh_var.get()
        
        for exp in expected_positions:
            dists = [np.linalg.norm(np.array(exp) - np.array(d)) for d in detected_positions]
            if not dists:
                missing_bumps.append(exp)
            else:
                min_dist = min(dists)
                if min_dist > align_thresh:
                    # could be missing or misaligned
                    if min_dist < align_thresh * 3:
                        misaligned_bumps.append(exp)
                    else:
                        missing_bumps.append(exp)
        
        return missing_bumps, misaligned_bumps
    
    # -----------------------------------------
    # 8. Train Autoencoder (on currently detected bumps)
    # -----------------------------------------
    def train_autoencoder(self):
        if not self.bumps_contours:
            messagebox.showwarning("Warning", "No bumps detected to train on.")
            return
        
        if self.processed_image is None:
            messagebox.showwarning("Warning", "Please process the image first.")
            return
        
        patch_size = RECIPE["autoencoder_patch_size"]
        patches = []
        
        # Extract each bump patch
        for cnt in self.bumps_contours:
            x, y, w, h = cv2.boundingRect(cnt)
            crop = self.processed_image[y:y+h, x:x+w]
            crop = cv2.resize(crop, (patch_size, patch_size))
            patches.append(crop)
        
        # Convert to float, scale 0-1
        patches = np.array(patches, dtype=np.float32) / 255.0
        patches = np.expand_dims(patches, axis=-1)  # shape (N, 32, 32, 1)
        
        # Build or re-build the autoencoder
        self.autoencoder = self.build_autoencoder(input_shape=(patch_size, patch_size, 1))
        
        # Train
        epochs = RECIPE["autoencoder_epochs"]
        batch_size = RECIPE["autoencoder_batch_size"]
        
        self.autoencoder.fit(patches, patches, epochs=epochs, batch_size=batch_size, validation_split=0.1)
        
        self.ae_trained = True
        messagebox.showinfo("Info", "Autoencoder training completed.")
    
    def build_autoencoder(self, input_shape):
        # Example architecture
        inp = Input(shape=input_shape)
        
        # Encoder
        x = Conv2D(16, (3,3), activation='relu', padding='same')(inp)
        x = MaxPooling2D((2,2), padding='same')(x)
        x = Conv2D(8, (3,3), activation='relu', padding='same')(x)
        x = MaxPooling2D((2,2), padding='same')(x)
        
        # Bottleneck
        # You could add more layers here if needed.
        
        # Decoder
        x = Conv2D(8, (3,3), activation='relu', padding='same')(x)
        x = UpSampling2D((2,2))(x)
        x = Conv2D(16, (3,3), activation='relu', padding='same')(x)
        x = UpSampling2D((2,2))(x)
        
        outp = Conv2D(1, (3,3), activation='sigmoid', padding='same')(x)
        
        autoenc = Model(inp, outp)
        autoenc.compile(optimizer='adam', loss='mse')
        autoenc.summary()
        return autoenc
    
    # -----------------------------------------
    # 9. Export Bumps
    # -----------------------------------------
    def export_bumps(self):
        if not self.bumps_contours:
            messagebox.showwarning("Warning", "No bumps detected to export.")
            return
        
        if self.processed_image is None:
            messagebox.showwarning("Warning", "Please process the image first.")
            return
        
        export_dir = filedialog.askdirectory()
        if not export_dir:
            return
        
        patch_size = RECIPE["autoencoder_patch_size"]
        for i, cnt in enumerate(self.bumps_contours):
            x, y, w, h = cv2.boundingRect(cnt)
            crop = self.processed_image[y:y+h, x:x+w]
            crop = cv2.resize(crop, (patch_size, patch_size))
            filename = os.path.join(export_dir, f"bump_{i}.png")
            cv2.imwrite(filename, crop)
        
        messagebox.showinfo("Export", f"Exported {len(self.bumps_contours)} bumps to {export_dir}")
    
    # -----------------------------------------
    # 10. Update (Fine-Tune) Model with New Data
    # -----------------------------------------
    def update_model(self):
        """
        Demonstrates how you'd re-train or fine-tune the existing autoencoder 
        with new data (user-labeled good bumps, for example).
        """
        if not self.autoencoder or not self.ae_trained:
            messagebox.showwarning("Warning", "No trained model found. Train first.")
            return
        
        # Suppose user picks a folder of known good bumps or newly captured bumps
        folder = filedialog.askdirectory()
        if not folder:
            return
        
        # Load images for additional training
        patch_size = RECIPE["autoencoder_patch_size"]
        new_bumps = []
        for file in os.listdir(folder):
            if file.lower().endswith((".png", ".jpg", ".jpeg", ".bmp")):
                path = os.path.join(folder, file)
                img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
                if img is not None:
                    img = cv2.resize(img, (patch_size, patch_size))
                    img = img.astype(np.float32) / 255.0
                    new_bumps.append(img)
        
        if not new_bumps:
            messagebox.showwarning("Warning", "No valid images found in the folder.")
            return
        
        new_bumps = np.array(new_bumps)
        new_bumps = np.expand_dims(new_bumps, axis=-1)  # shape (N, 32, 32, 1)
        
        # Fine-tune or continue training
        self.autoencoder.fit(new_bumps, new_bumps,
                             epochs=RECIPE["autoencoder_epochs"],
                             batch_size=RECIPE["autoencoder_batch_size"],
                             validation_split=0.1)
        
        messagebox.showinfo("Update Model", "Model has been fine-tuned with new data.")
        
    # -----------------------------------------
    # Utility: Show Image in TK Label
    # -----------------------------------------
    def show_image(self, img):
        if len(img.shape) == 2:
            disp_img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
        else:
            disp_img = img.copy()
        
        disp_img = cv2.resize(disp_img, (400, 400))  # for display
        disp_img = cv2.cvtColor(disp_img, cv2.COLOR_BGR2RGB)
        
        from PIL import Image, ImageTk
        im = Image.fromarray(disp_img)
        imgtk = ImageTk.PhotoImage(image=im)
        self.image_panel.configure(image=imgtk)
        self.image_panel.image = imgtk  # keep reference

def main():
    root = tk.Tk()
    app = BumpInspectorGUI(root)
    root.mainloop()

if __name__ == "__main__":
    main()


